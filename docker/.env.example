# ================================================================
# n8n M-Pesa Course — Local Environment Template
# Copy this file to `.env` and fill in your values.
# ================================================================

# --- n8n basic auth (login to http://localhost:5678) ---
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# Generate with: openssl rand -hex 16
N8N_ENCRYPTION_KEY=change-me-to-a-random-32-char-string

# When running behind ngrok/VPS, set these to your public URL
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# --- Postgres ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n
POSTGRES_DB=n8n

# --- M-Pesa Daraja ---
# Get these from https://developer.safaricom.co.ke
MPESA_ENV=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Public URL where Safaricom will POST the callback.
# Local dev: use ngrok -> https://xxxx.ngrok-free.app
# Production: your domain -> https://api.yourdomain.co.ke
MPESA_CALLBACK_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# --- ngrok (optional, for local dev) ---
# Get free token: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# --- Course access control (gated repo) ---
# See docs/access-control.md for the full setup.
GH_REPO_OWNER=tkivite
GH_REPO_NAME=n8n-mpesa-course
GH_ADMIN_TOKEN=                    # fine-grained PAT with Administration: R/W on the repo
GUMROAD_WEBHOOK_SECRET=            # any random string; placed in Gumroad ping URL
COURSE_SITE_URL=https://yourcourse.co.ke
COURSE_FROM_EMAIL=hello@yourcourse.co.ke

